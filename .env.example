# SpaceDoc Intelligence Configuration Example
# Copy to .env and populate with your local values

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=spacedoc
DB_USER=spacedoc
DB_PASSWORD=spacedoc_local_dev_password
JDBC_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}

# PostgreSQL pgvector settings
PGVECTOR_DIMENSION=384

# ============================================================================
# AI RUNTIME CONFIGURATION
# ============================================================================

# Ollama (Local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=mistral
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Optional: OpenAI (if using hosted provider)
# OPENAI_API_KEY=your-openai-key-here
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# AI Provider selection: 'ollama' or 'openai'
AI_PROVIDER=ollama

# ============================================================================
# RAG PIPELINE CONFIGURATION
# ============================================================================

# Document chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=128
MIN_CHUNK_SIZE=50

# Retrieval parameters
RETRIEVAL_TOP_K=10
SIMILARITY_THRESHOLD=0.5
LEXICAL_WEIGHT=0.3
VECTOR_WEIGHT=0.7

# Dependency graph expansion
MAX_GRAPH_DEPTH=3
MAX_EXPANSION_RESULTS=20
EXPANSION_TIMEOUT_SECONDS=10

# Document ingestion
MAX_UPLOAD_SIZE_MB=50
MAX_URL_RESPONSE_SIZE_MB=10
INGESTION_TIMEOUT_SECONDS=60
ALLOWED_URL_PATTERNS=https://.*\\.isro\\.gov\\.in.*,https://.*\\.nasa\\.gov.*

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

# Session configuration
SESSION_TIMEOUT_MINUTES=30
SECURE_COOKIES=true
HTTPONLY_COOKIES=true
SAMESITE_COOKIES=Strict

# Authentication (local development)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_local_dev_password

# Secret key for CSRF and session (change in production)
SECRET_KEY=local-dev-secret-key-change-in-production

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

LOG_LEVEL=INFO
LOG_FILE=logs/spacedoc.log
LOG_MAX_FILE_SIZE=10MB
LOG_MAX_HISTORY_DAYS=30

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/
ENVIRONMENT=development

# ============================================================================
# OPTIONAL: DEPLOYMENT SETTINGS
# ============================================================================

# For Docker deployment
DOCKER_NETWORK=spacedoc-network
POSTGRES_VERSION=16-alpine
